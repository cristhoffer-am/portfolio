---
import Layout from "../layouts/Layout.astro";
import { education, experience, interests, profile, skillGroups, strengths } from "../data/profile";
---

<Layout
  title={`CV de ${profile.name}`}
  description={profile.subtitle}
  variant="document"
>
  <div class="no-print sticky top-0 z-40 border-b border-slate-200 bg-white/90 backdrop-blur-md">
    <div class="mx-auto flex max-w-3xl flex-col gap-3 px-5 py-4 sm:flex-row sm:items-center sm:justify-between">
      <a href="/" class="text-sm font-semibold text-slate-600 transition-colors hover:text-blue-700">
        ← Volver al portafolio
      </a>
      <button
        id="guardar-pdf"
        type="button"
        class="inline-flex cursor-pointer items-center justify-center rounded-full bg-blue-600 px-5 py-2.5 text-sm font-semibold text-white transition-all duration-300 hover:scale-105 hover:bg-blue-700"
      >
        Guardar PDF
      </button>
    </div>
  </div>

  <article class="cv-sheet mx-auto my-10 max-w-3xl rounded-[1.75rem] border border-slate-200 bg-white px-6 py-12 shadow-[0_24px_70px_-40px_rgba(15,23,42,0.45)] sm:my-14 sm:px-14 sm:py-16">
    <header class="border-b border-slate-200 pb-8">
      <p class="text-xs font-semibold uppercase tracking-[0.22em] text-blue-700">Currículum</p>
      <h1 class="mt-3 font-serif text-4xl font-medium tracking-tight text-slate-900 sm:text-5xl">
        {profile.name}
      </h1>
      <p class="mt-4 text-lg font-medium leading-snug text-blue-800">{profile.title}</p>
      <p class="mt-4 max-w-2xl text-base leading-relaxed text-slate-600">{profile.subtitle}</p>
      <ul class="mt-6 flex flex-col gap-1.5 text-sm text-slate-700 sm:flex-row sm:flex-wrap sm:gap-x-5 sm:gap-y-1">
        <li><a class="hover:text-blue-700" href={profile.phoneHref}>{profile.phone}</a></li>
        <li><a class="break-all hover:text-blue-700" href={profile.emailHref}>{profile.email}</a></li>
        <li>{profile.location}</li>
        <li>
          <a class="font-medium text-blue-700 hover:underline" href={profile.linkedin} target="_blank" rel="noopener noreferrer">
            LinkedIn
          </a>
        </li>
      </ul>
    </header>

    <section class="cv-block mt-12">
      <h2 class="border-b border-slate-200 pb-2 font-serif text-2xl text-slate-900">Sobre mí</h2>
      <p class="mt-5 leading-8 text-slate-700">{profile.about}</p>
    </section>

    <section class="cv-block mt-12">
      <h2 class="border-b border-slate-200 pb-2 font-serif text-2xl text-slate-900">Experiencia laboral</h2>
      <div class="mt-7 space-y-8">
        {
          experience.map((job) => (
            <article>
              <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
                <h3 class="text-lg font-semibold text-slate-900">
                  {job.role} <span class="font-medium text-blue-700">· {job.company}</span>
                </h3>
                <p class="text-sm text-slate-500">{job.period}</p>
              </div>
              <ul class="mt-3 space-y-1.5">
                {job.highlights.map((item) => (
                  <li class="flex gap-2.5 text-slate-700">
                    <span class="mt-[0.55rem] size-1.5 shrink-0 rounded-full bg-blue-600"></span>
                    <span class="leading-relaxed">{item}</span>
                  </li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
    </section>

    <section class="cv-block mt-12">
      <h2 class="border-b border-slate-200 pb-2 font-serif text-2xl text-slate-900">Habilidades</h2>
      <div class="mt-7 space-y-6">
        {
          skillGroups.map((group) => (
            <div>
              <p class="text-sm font-semibold text-slate-900">{group.title}</p>
              <ul class="mt-3 flex flex-wrap gap-2">
                {group.items.map((item) => (
                  <li class="rounded-full bg-blue-50 px-3 py-1 text-sm font-medium text-blue-800 ring-1 ring-blue-100">
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
        <div>
          <p class="text-sm font-semibold text-slate-900">Forma de trabajo</p>
          <ul class="mt-3 flex flex-wrap gap-2">
            {
              strengths.map((item) => (
                <li class="rounded-full bg-slate-100 px-3 py-1 text-sm font-medium text-slate-700">
                  {item}
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </section>

    <section class="cv-block mt-12">
      <h2 class="border-b border-slate-200 pb-2 font-serif text-2xl text-slate-900">Educación</h2>
      <ul class="mt-7 space-y-4">
        {
          education.map((item) => (
            <li class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between">
              <p class="text-slate-800">
                <span class="font-semibold">{item.program}</span>
                <span class="text-slate-600"> · {item.school}</span>
              </p>
              <p class="text-sm font-medium text-blue-700">{item.period}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="cv-block mt-12">
      <h2 class="border-b border-slate-200 pb-2 font-serif text-2xl text-slate-900">Intereses</h2>
      <ul class="mt-5 flex flex-wrap gap-2">
        {
          interests.map((item) => (
            <li class="rounded-full bg-slate-100 px-3 py-1 text-sm font-medium text-slate-700">{item}</li>
          ))
        }
      </ul>
    </section>
  </article>

  <p class="no-print mx-auto mb-14 max-w-3xl px-5 text-center text-sm leading-relaxed text-slate-500">
    En la ventana de impresión elige «Guardar como PDF».
  </p>

  <script is:inline>
    document.getElementById("guardar-pdf")?.addEventListener("click", () => window.print());
  </script>
</Layout>
