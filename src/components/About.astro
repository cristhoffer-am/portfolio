---
import { profile } from "../data/profile";
import SectionHeading from "./SectionHeading.astro";

const sectors = [
  { name: "Retail", note: "Cajas de alta rotación y supervisión de equipo." },
  { name: "Salud", note: "Admisión, comprobantes y reportes de ingresos." },
  { name: "Servicios", note: "Atención al público y control de valores." },
];
---

<section id="sobre-mi" class="scroll-mt-24 py-24 sm:py-32">
  <div class="mx-auto grid max-w-6xl gap-14 px-5 sm:px-8 lg:grid-cols-[0.85fr_1.15fr] lg:items-start">
    <SectionHeading eyebrow="Perfil" title="Sobre mí" />

    <div>
      <p class="text-lg leading-8 text-slate-700 sm:text-xl sm:leading-9">
        {profile.about}
      </p>

      <ul class="mt-8 grid gap-3 sm:grid-cols-3">
        {
          sectors.map((sector) => (
            <li class="rounded-2xl border border-slate-200 bg-white p-4 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-blue-200 hover:shadow-md">
              <p class="font-serif text-xl text-slate-900">{sector.name}</p>
              <p class="mt-1 text-sm leading-relaxed text-slate-600">{sector.note}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
