---
interface Props {
  eyebrow: string;
  title: string;
  lede?: string;
}

const { eyebrow, title, lede } = Astro.props;
---

<div class="max-w-2xl">
  <p class="text-sm font-semibold uppercase tracking-[0.22em] text-blue-700">{eyebrow}</p>
  <h2 class="mt-3 font-serif text-4xl font-medium tracking-tight text-slate-900 sm:text-5xl">
    {title}
  </h2>
  {
    lede && (
      <p class="mt-4 text-lg leading-relaxed text-slate-600">{lede}</p>
    )
  }
</div>
