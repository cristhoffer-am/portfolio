---
import { skillGroups, strengths } from "../data/profile";
import Icon from "./Icon.astro";
import SectionHeading from "./SectionHeading.astro";
---

<section id="habilidades" class="scroll-mt-24 border-y border-slate-200/80 bg-white py-24 sm:py-32">
  <div class="mx-auto max-w-6xl px-5 sm:px-8">
    <SectionHeading
      eyebrow="Oficio"
      title="Habilidades"
      lede="Lo que un reclutador puede ver de un vistazo: caja, personas y herramientas."
    />

    <div class="mt-16 grid gap-6 lg:grid-cols-3">
      {
        skillGroups.map((group) => (
          <article class="group flex h-full flex-col rounded-[1.75rem] border border-slate-200 bg-slate-50 p-7 shadow-sm transition-all duration-300 hover:-translate-y-1 hover:border-blue-200 hover:bg-white hover:shadow-lg sm:p-8">
            <div class="grid size-12 place-items-center rounded-2xl bg-blue-600 text-white shadow-sm transition-all duration-300 group-hover:scale-105">
              <Icon name={group.icon} class="size-5" />
            </div>
            <h3 class="mt-6 font-serif text-2xl text-slate-900">{group.title}</h3>
            <ul class="mt-6 flex flex-wrap gap-2">
              {group.items.map((item) => (
                <li class="rounded-full bg-blue-50 px-3 py-1.5 text-sm font-medium text-blue-800 ring-1 ring-blue-100">
                  {item}
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>

    <div class="mt-8 rounded-[1.75rem] border border-slate-200 bg-slate-50 px-7 py-7 sm:px-8">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-blue-700">Forma de trabajo</p>
      <ul class="mt-4 flex flex-wrap gap-2">
        {
          strengths.map((item) => (
            <li class="rounded-full bg-white px-3 py-1.5 text-sm font-medium text-slate-700 ring-1 ring-slate-200">
              {item}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>
