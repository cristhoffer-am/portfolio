---
import { profile } from "../data/profile";
import Icon from "./Icon.astro";

const channels = [
  {
    label: "Teléfono",
    value: profile.phone,
    href: profile.phoneHref,
    icon: "phone" as const,
    external: false,
  },
  {
    label: "Correo",
    value: profile.email,
    href: profile.emailHref,
    icon: "mail" as const,
    external: false,
  },
  {
    label: "Ubicación",
    value: profile.location,
    href: profile.locationHref,
    icon: "pin" as const,
    external: true,
  },
  {
    label: profile.linkedinLabel,
    value: "Ver perfil profesional",
    href: profile.linkedin,
    icon: "linkedin" as const,
    external: true,
  },
];
---

<footer id="contacto" class="scroll-mt-24 bg-slate-900 text-white">
  <div class="mx-auto max-w-6xl px-5 py-20 sm:px-8 sm:py-24">
    <p class="text-sm font-semibold uppercase tracking-[0.22em] text-blue-300">Contacto</p>
    <h2 class="mt-3 max-w-xl font-serif text-4xl font-medium tracking-tight sm:text-5xl">
      Conversemos sobre caja, equipo y control.
    </h2>
    <p class="mt-4 max-w-xl text-lg leading-relaxed text-slate-300">
      Una llamada, un correo o LinkedIn. Estoy en Santa Anita, Lima.
    </p>

    <ul class="mt-12 grid gap-4 sm:grid-cols-2">
      {
        channels.map((channel) => (
          <li>
            <a
              href={channel.href}
              class="group flex h-full items-center gap-4 rounded-[1.5rem] border border-white/10 bg-white/5 p-5 transition-all duration-300 hover:scale-[1.02] hover:border-blue-400/40 hover:bg-white/10"
              {...(channel.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
            >
              <span class="grid size-12 shrink-0 place-items-center rounded-2xl bg-blue-600 text-white transition-all duration-300 group-hover:scale-105">
                <Icon name={channel.icon} class="size-5" />
              </span>
              <span class="min-w-0">
                <span class="block text-xs font-semibold uppercase tracking-[0.16em] text-blue-200">
                  {channel.label}
                </span>
                <span class="mt-1 block text-base font-medium break-words text-white">{channel.value}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>

  <div class="border-t border-white/10">
    <div class="mx-auto flex max-w-6xl flex-col gap-3 px-5 py-6 text-sm text-slate-400 sm:flex-row sm:items-center sm:justify-between sm:px-8">
      <p>© {new Date().getFullYear()} {profile.name}</p>
      <a href="#inicio" class="transition-colors hover:text-white">Volver al inicio</a>
    </div>
  </div>
</footer>
