---
import { highlights, profile } from "../data/profile";
import Icon from "./Icon.astro";
---

<section id="inicio" class="relative scroll-mt-24 overflow-hidden">
  <div class="pointer-events-none absolute -right-24 -top-24 size-[28rem] rounded-full bg-blue-200/40 blur-3xl"></div>
  <div class="pointer-events-none absolute -left-20 bottom-0 size-72 rounded-full bg-slate-200/70 blur-3xl"></div>

  <div class="relative mx-auto grid max-w-6xl items-center gap-12 px-5 py-16 sm:px-8 sm:py-20 lg:grid-cols-[1.15fr_0.85fr] lg:py-24">
    <div>
      <p class="rise text-sm font-semibold uppercase tracking-[0.22em] text-blue-700">
        Portafolio profesional
      </p>
      <h1 class="rise rise-2 mt-4 font-serif text-[2.7rem] font-medium leading-[0.95] tracking-tight text-slate-900 sm:text-6xl lg:text-7xl">
        Cristhoffer<br />Aylas Moreno
      </h1>
      <p class="rise rise-3 mt-6 max-w-xl text-lg font-medium leading-snug text-blue-800 sm:text-xl">
        {profile.title}
      </p>
      <p class="rise rise-4 mt-4 max-w-xl text-base leading-relaxed text-slate-600 sm:text-lg">
        {profile.subtitle}
      </p>

      <div class="rise rise-5 mt-8 flex flex-col gap-3 sm:flex-row">
        <a
          href={profile.cvHref}
          class="inline-flex items-center justify-center gap-2 rounded-full bg-blue-600 px-6 py-3.5 text-sm font-semibold text-white shadow-sm transition-all duration-300 hover:scale-105 hover:bg-blue-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-700"
        >
          <Icon name="download" class="size-4" />
          Descargar CV
        </a>
        <a
          href="#contacto"
          class="inline-flex items-center justify-center gap-2 rounded-full border border-slate-300 bg-white px-6 py-3.5 text-sm font-semibold text-slate-900 transition-all duration-300 hover:scale-105 hover:border-blue-600 hover:text-blue-700 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-700"
        >
          Contactar
          <Icon name="arrow" class="size-4" />
        </a>
      </div>
    </div>

    <aside class="rise rise-4 relative">
      <div class="overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-[0_24px_70px_-36px_rgba(15,23,42,0.45)]">
        <div class="relative bg-gradient-to-br from-blue-700 to-blue-600 px-7 pb-8 pt-8 text-center">
          <div class="absolute inset-0 opacity-25 bg-[linear-gradient(to_bottom,transparent_11px,white_12px)] bg-[length:100%_12px]"></div>
          <div class="relative mx-auto grid size-20 place-items-center rounded-full bg-white font-serif text-2xl font-semibold text-blue-800 shadow-md ring-4 ring-white/40">
            {profile.initials}
          </div>
          <p class="relative mt-4 font-serif text-2xl text-white">{profile.shortName}</p>
          <p class="relative mt-1 text-sm text-white/90">Supervisor de cajas y operaciones</p>
        </div>
        <div class="px-7 py-6">
          <dl class="space-y-3">
            <div class="flex items-start justify-between gap-4 text-sm">
              <dt class="text-slate-500">Experiencia</dt>
              <dd class="text-right font-semibold text-slate-900">Más de 6 años</dd>
            </div>
            <div class="flex items-start justify-between gap-4 text-sm">
              <dt class="text-slate-500">Formación</dt>
              <dd class="text-right font-semibold text-slate-900">Certus · Egresado</dd>
            </div>
            <div class="flex items-start justify-between gap-4 text-sm">
              <dt class="text-slate-500">Siguiente paso</dt>
              <dd class="text-right font-semibold text-blue-700">ADEX · 2027</dd>
            </div>
            <div class="flex items-start justify-between gap-4 text-sm">
              <dt class="text-slate-500">Ubicación</dt>
              <dd class="text-right font-semibold text-slate-900">Santa Anita, Lima</dd>
            </div>
          </dl>
        </div>
      </div>
    </aside>
  </div>

  <div class="relative border-y border-slate-200/80 bg-white/70">
    <ul class="mx-auto grid max-w-6xl gap-px bg-slate-200 sm:grid-cols-2 lg:grid-cols-4">
      {
        highlights.map((item) => (
          <li class="bg-slate-50 px-6 py-5">
            <p class="text-xs font-semibold uppercase tracking-[0.16em] text-blue-700">{item.label}</p>
            <p class="mt-1 font-medium text-slate-900">{item.value}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
